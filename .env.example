# Browser-public configuration
# Only VITE_/PUBLIC_ values are bundled into the frontend. Never put service
# role keys, provider secrets, webhook secrets, or internal API keys here.

# Supabase browser configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe publishable key only
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Whop OAuth public client configuration
# Client secrets and API keys stay server-side.
VITE_WHOP_CLIENT_ID=your_whop_client_id
VITE_WHOP_REDIRECT_URI=http://localhost:5173/auth/whop/callback

# Economics importer public function key for /econ-importer.
# Do not reuse provider or service-role secrets here.
VITE_ECON_SYNC_API_KEY=your_econ_sync_public_gate_key_here

# Functions base URL for local development
# Leave commented out when using Supabase Edge Functions
# VITE_FUNCTIONS_BASE=http://localhost:8888

# Server-only / Supabase Edge Function secrets
# Do not prefix these with VITE_ or PUBLIC_.

# Supabase service role key for trusted server-side jobs and Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Gemini AI server-side key
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SerpAPI server-side key (Job Search)
# Get API key from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here
SERP_API_KEY=your_serpapi_key_here

# Bureau of Labor Statistics API (optional)
BLS_API_KEY=your_bls_api_key_here

# O*NET Web Services
# Register at: https://services.onetcenter.org/developer/signup
ONET_USERNAME=your_onet_username
ONET_PASSWORD=your_onet_password

# APO server-to-server function key (required — requests rejected if unset)
# Generate with: openssl rand -hex 32
# Browser clients must not receive this value. Use JWT, origin/rate controls,
# or a trusted proxy for public app flows.
APO_FUNCTION_API_KEY=generate_random_32_char_hex_string_here

# Optional per-minute rate limits for PH6 functions
# Defaults used if not set
HL_RATE_LIMIT_PER_MIN=60
AR_RATE_LIMIT_PER_MIN=60
SIM_RATE_LIMIT_PER_MIN=30
CASCADE_RATE_LIMIT_PER_MIN=30
PORTFOLIO_RATE_LIMIT_PER_MIN=30

# ============================================================================
# MONETIZATION - STRIPE
# ============================================================================
# Test proof verifier key. Use only for owner-run Stripe test checkout proof.
STRIPE_TEST_SECRET_KEY=sk_test_your_test_secret_key

# Deployed Supabase Edge Function Stripe key.
# Use the mode appropriate for the deployed/staging function; do not rely on this
# generic name for the owner-run test checkout verifier.
STRIPE_SECRET_KEY=sk_live_or_test_edge_function_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# WHOP MARKETPLACE INTEGRATION
# ============================================================================
# Register at: https://dev.whop.com
# 1. Create new app in Whop Developer Portal
# 2. Configure OAuth redirect URI
# 3. Set up webhook URL: https://YOUR_PROJECT.supabase.co/functions/v1/whop-webhook

# For Edge Function OAuth and webhook verification
WHOP_CLIENT_SECRET=your_whop_client_secret
WHOP_API_KEY=your_whop_api_key
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret

# Whop OAuth allowed origins (comma-separated, no wildcards)
WHOP_ALLOWED_ORIGINS=https://automationinsights.app
WHOP_ALLOWED_REDIRECT_URIS=https://automationinsights.app/auth/whop/callback

# ============================================================================
# SENTRY ERROR MONITORING
# ============================================================================
# Get DSN from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
