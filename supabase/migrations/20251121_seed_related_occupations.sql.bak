-- Verify seed count
DO $$
DECLARE
  total_count INTEGER;
BEGIN
  SELECT COUNT(*) INTO total_count FROM public.onet_related_occupations;
  RAISE NOTICE 'Total related occupations seeded: %', total_count;
END $$;
